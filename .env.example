# --- required in production ---
BC_ENV=production
# External Postgres such as Neon. Do NOT use Render's free database:
# it is deleted 30 days after creation. Prefix must be postgresql+psycopg://
BC_DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
PUBLIC_BASE_URL=https://your-domain.com
LS_API_KEY=
LS_STORE_ID=
LS_SIGNING_SECRET=
LS_VARIANT_MONTHLY=
LS_VARIANT_ONEOFF=

# --- storage ---
# Free hosts lose local files when the service sleeps after 15 minutes idle.
# Keep uploads on a temporary path; reports live in the database.
BC_DATA_DIR=/tmp/data

# --- AI extraction ---
# Provider: gemini | groq | ollama | openai
BC_LLM_PROVIDER=gemini
BC_GEMINI_API_KEY=
BC_GEMINI_MODEL=gemini-3.7-flash
# Groq alternative, OpenAI-compatible, also has a free tier
# BC_GROQ_API_KEY=
# BC_GROQ_MODEL=openai/gpt-oss-120b
# Local Ollama, free but only on your own machine
# BC_OLLAMA_HOST=http://localhost:11434
# BC_OLLAMA_MODEL=qwen2.5:7b-instruct
# Pace requests: free tiers allow roughly 30 per minute
BC_LLM_DELAY_MS=2000
# Bound the work so a long tender finishes before a free host sleeps
BC_LLM_MAX_CALLS=8
BC_LLM_TIMEOUT=600
BC_STALE_ANALYSIS_SECONDS=420

# --- limits ---
BC_FREE_QUOTA=3
BC_FREE_MAX_PAGES=80
BC_PRO_QUOTA=150
BC_SESSION_TTL_DAYS=30
BC_SESSION_COOKIE=bgc_session
BC_COOKIE_SECURE=1

# --- local development only ---
# BC_BILLING_DEV=1